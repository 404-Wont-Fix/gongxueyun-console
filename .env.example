# ===== 基础 =====
# 必改：至少 32 位随机串，用于签发登录 token 和加密账号密码
APP_SECRET=please-change-this-to-a-random-32chars-secret
APP_ENV=production
APP_TIMEZONE_OFFSET=8

# 管理员（首次启动自动创建；已存在则不会覆盖密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# ===== 数据库 =====
# 默认 SQLite，数据落在 ./data/gxy.db
DATABASE_URL=sqlite:////data/gxy.db
# 也可用 MySQL（需自行启动数据库并安装 pymysql）：
# DATABASE_URL=mysql+pymysql://gxy:gxy@mysql:3306/gxy?charset=utf8mb4

# ===== 服务 =====
BACKEND_PORT=8000
FRONTEND_PORT=8080
# 允许跨域的前端地址，逗号分隔；同源部署可留空
CORS_ORIGINS=
# 自动打卡调度器（后端进程内运行）
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# 单账号同一时刻只允许一个写入任务，锁超时秒数
TASK_LOCK_SECONDS=300

# ===== 工学云客户端 =====
# 默认 5.41.6 / 50291 / codeVersion 292（与本地 APK 分析一致）
GXY_PACKAGE_VERSION=5.41.6
GXY_BUILD_NUMBER=50291
GXY_CODE_VERSION=292
GXY_TIMEOUT_SECONDS=15


# ===== 地图与地理编码（也可在设置页配置，设置页优先）=====
# 默认使用高德栅格瓦片（GCJ-02），当前模板请求不带 Key；可用性与许可遵循提供方条款。
# 如需换成 OSM：MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
#              MAP_TILE_SUBDOMAINS=abc
#              MAP_TILE_COORD=wgs84
MAP_TILE_URL=https://webrd0{s}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}
MAP_TILE_SUBDOMAINS=1234
MAP_TILE_COORD=gcj02
MAP_TILE_ATTRIBUTION=© 高德地图

# 地址搜索 / 反查：amap（默认，需 AMAP_KEY，国内更准）或 osm（Nominatim，无需 Key）
GEOCODE_PROVIDER=amap
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
AMAP_KEY=

# ===== 验证码 =====
# 滑块（登录）默认用 OpenCV 模板匹配，无需模型。
# 点选（打卡 302）需要 ONNX 模型：把 yolov5n.onnx 与 ocr.onnx 放进该目录即可启用自动识别。
CAPTCHA_MODEL_DIR=
CAPTCHA_MODEL_AUTO_DOWNLOAD=false

# ===== 通知（可选，逗号分隔多通道）=====
# 支持 webhook / pushplus / serverchan / ntfy
NOTIFY_WEBHOOK_URL=
NOTIFY_PUSHPLUS_TOKEN=
NOTIFY_SERVERCHAN_KEY=
NOTIFY_NTFY_URL=
NOTIFY_EVENTS=verification_required,failed,daily_summary

# ===== 报告 AI（可选；也可在设置页配置，设置页优先）=====
# 兼容 OpenAI Chat Completions 的服务；留空则只用内置模板
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
